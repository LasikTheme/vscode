{
  "name": "lasik",
  "displayName": "Lasik",
  "description": "A dark, easy on the eyes theme that has decent contrast for coders with sensitive eyes",
  "version": "0.1.4",
  "publisher": "AmnaAkram",
  "homepage": "https://github.com/aamnah/lasik-vscode-theme#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/aamnah/lasik-vscode-theme.git"
  },
  "bugs": {
    "url": "https://github.com/aamnah/lasik-vscode-theme/issues"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/aamnah"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#01030a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Themes",
    "Programming Languages"
  ],
  "keywords": [
    "Theme",
    "Dark Theme"
  ],
  "contributes": {
    "themes": [
      {
        "id": "Lasik",
        "label": "Lasik Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/Lasik-Dark-color-theme.json"
      },
      {
        "label": "Lasik Dark Quiet",
        "uiTheme": "vs-dark",
        "path": "./themes/Lasik-Dark-Quiet-color-theme.json"
      },
      {
        "label": "Lasik Dark High Contrast",
        "uiTheme": "hc-black",
        "path": "./themes/Lasik-Dark-High-Contrast-color-theme.json"
      }
    ],
    "grammars": [
      {
        "language": "dotenv",
        "scopeName": "source.env",
        "path": "./syntaxes/dotenv/env.tmLanguage.json"
      },
      {
        "language": "asm-nasm",
        "scopeName": "source.asm.nasm",
        "path": "./syntaxes/nasm/nasm.tmLanguage.json"
      },
      {
        "language": "toml",
        "scopeName": "source.toml",
        "path": "./syntaxes/toml/toml.tmLanguage.json"
      },
      {
        "language": "csv",
        "scopeName": "text.csv",
        "path": "./syntaxes/csv/csv.tmLanguage.json"
      },
      {
        "language": "tsv",
        "scopeName": "text.tsv",
        "path": "./syntaxes/csv/tsv.tmLanguage.json"
      }
    ],
    "languages": [
      {
        "id": "dotenv",
        "aliases": [
          ".env",
          "env",
          "dotenv",
          "secrets",
          "key",
          "environment variables"
        ],
        "configuration": "./syntaxes/dotenv/language-configuration.json",
        "extensions": [
          ".env",
          ".env.vault",
          ".flaskenv",
          ".env-sample",
          ".env.sample",
          ".env.example",
          ".env.local",
          ".env.dev",
          ".env.dev.local",
          ".env.build",
          ".env.build.local",
          ".env.development",
          ".env.development.local",
          ".env.test",
          ".env.test.local",
          ".env.testing",
          ".env.qa",
          ".env.qa.local",
          ".env.ci",
          ".env.ci.local",
          ".env.uat",
          ".env.uat.local",
          ".env.stag",
          ".env.stag.local",
          ".env.stage",
          ".env.stage.local",
          ".env.staging",
          ".env.staging.local",
          ".env.live",
          ".env.live.local",
          ".env.production",
          ".env.production.local",
          ".env.prod",
          ".env.prod.local",
          ".env.previous",
          ".env.staging.previous",
          ".env.production.previous",
          ".env.secret",
          ".env.secrets",
          ".env.sync",
          ".env.deploy",
          ".env.deployment"
        ]
      },
      {
        "id": "asm-nasm",
        "aliases": [
          "Assembly (x86 NASM)",
          "nasm",
          "asm"
        ],
        "extensions": [
          ".asm",
          ".nasm"
        ],
        "configuration": "./syntaxes/nasm/language-configuration.json"
      },
      {
        "id": "toml",
        "aliases": [
          "TOML",
          "toml"
        ],
        "extensions": [
          ".toml"
        ],
        "filenames": [
          "Cargo.lock",
          "Pipfile",
          "uv.lock",
          "poetry.lock"
        ],
        "configuration": "./syntaxes/toml/language-configuration.json"
      },
      {
        "id": "csv",
        "aliases": [
          "CSV (rainbow)",
          "csv"
        ],
        "extensions": [
          ".csv"
        ]
      },
      {
        "id": "tsv",
        "aliases": [
          "TSV (rainbow)",
          "tsv"
        ],
        "extensions": [
          ".tsv",
          ".tab"
        ]
      },
      {
        "id": "ini",
        "extensions": [
          ".service",
          ".socket",
          ".timer",
          ".target",
          ".mount",
          ".automount",
          ".path",
          ".slice",
          ".swap",
          ".network",
          ".netdev",
          ".link"
        ]
      }
    ],
    "colors": [
      {
        "id": "lasik.dark",
        "description": "Dark color for editor/sidebar etc. background.",
        "defaults": {
          "dark": "#01030a",
          "light": "editor.background",
          "highContrast": "editor.background",
          "highContrastLight": "editor.background"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "deno task build"
  }
}
