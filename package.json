{
  "name": "lasik",
  "displayName": "Lasik Super Dark",
  "description": "A dark, easy on the eyes theme that has decent contrast for coders with sensitive eyes",
  "version": "0.1.4",
  "publisher": "AmnaAkram",
  "homepage": "https://github.com/aamnah/lasik/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/aamnah/lasik.git"
  },
  "bugs": {
    "url": "https://github.com/aamnah/lasik/issues"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/aamnah"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#01030a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Themes",
    "Programming Languages"
  ],
  "keywords": [
    "Theme",
    "Dark Theme"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Lasik",
        "uiTheme": "vs-dark",
        "path": "./themes/Lasik-color-theme.json"
      }
    ],
    "grammars": [
      {
        "language": "env",
        "scopeName": "source.env",
        "path": "./syntaxes/dotenv/env.tmLanguage"
      }
    ],
    "languages": [
      {
        "id": "env",
        "aliases": [
          "DotENV",
          "env",
          "dotenv"
        ],
        "configuration": "./syntaxes/dotenv/language-configuration.json",
        "extensions": [
          "..env",
          "..env.dist",
          "..env.local",
          "..env.sample",
          "..env.example",
          "..env.template",
          "..env.test",
          "..env.test.local",
          "..env.testing",
          "..env.dev",
          "..env.development",
          "..env.development.local",
          "..env.prod",
          "..env.production",
          "..env.production.local",
          "..env.dusk.local",
          "..env.staging",
          "..env.default",
          "..env.defaults",
          "..envrc",
          "..flaskenv",
          ".env",
          ".env.sample",
          ".env.example",
          ".env.template"
        ],
      }
    ],
    "colors": [
      {
        "id": "lasik.dark",
        "description": "Dark color for editor/sidebar etc. background.",
        "defaults": {
          "dark": "#01030a",
          "light": "editor.background",
          "highContrast": "editor.background",
          "highContrastLight": "editor.background"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "deno task build"
  }
}