{
  "name": "lasik",
  "displayName": "Lasik Super Dark",
  "description": "A dark, easy on the eyes theme that has decent contrast for coders with sensitive eyes",
  "version": "0.1.4",
  "publisher": "AmnaAkram",
  "homepage": "https://github.com/aamnah/lasik/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/aamnah/lasik.git"
  },
  "bugs": {
    "url": "https://github.com/aamnah/lasik/issues"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/aamnah"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#01030a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Themes",
    "Programming Languages"
  ],
  "keywords": [
    "Theme",
    "Dark Theme"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Lasik",
        "uiTheme": "vs-dark",
        "path": "./themes/Lasik-color-theme.json"
      }
    ],
    "grammars": [
      {
        "language": "env",
        "scopeName": "source.env",
        "path": "./syntaxes/dotenv/env.tmLanguage.json"
      }
    ],
    "languages": [
      {
        "id": "env",
        "aliases": [
          ".env",
          "env",
          "dotenv",
          "secrets",
          "key",
          "environment variables"
        ],
        "configuration": "./syntaxes/dotenv/language-configuration.json",
        "extensions": [
          ".env",
          ".env.vault",
          ".flaskenv",
          ".env-sample",
          ".env.sample",
          ".env.example",
          ".env.local",
          ".env.dev",
          ".env.dev.local",
          ".env.build",
          ".env.build.local",
          ".env.development",
          ".env.development.local",
          ".env.test",
          ".env.test.local",
          ".env.testing",
          ".env.qa",
          ".env.qa.local",
          ".env.ci",
          ".env.ci.local",
          ".env.uat",
          ".env.uat.local",
          ".env.stag",
          ".env.stag.local",
          ".env.stage",
          ".env.stage.local",
          ".env.staging",
          ".env.staging.local",
          ".env.live",
          ".env.live.local",
          ".env.production",
          ".env.production.local",
          ".env.prod",
          ".env.prod.local",
          ".env.previous",
          ".env.staging.previous",
          ".env.production.previous",
          ".env.secret",
          ".env.secrets",
          ".env.sync",
          ".env.deploy",
          ".env.deployment"
        ]
      }
    ],
    "colors": [
      {
        "id": "lasik.dark",
        "description": "Dark color for editor/sidebar etc. background.",
        "defaults": {
          "dark": "#01030a",
          "light": "editor.background",
          "highContrast": "editor.background",
          "highContrastLight": "editor.background"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "deno task build"
  }
}