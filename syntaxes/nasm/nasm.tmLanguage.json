{
  "name": "Assembly (x86 NASM)",
  "scopeName": "source.asm.nasm",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#data-label"
    },
    {
      "include": "#statement"
    },
    {
      "include": "#label"
    },
    {
      "include": "#directive"
    },
    {
      "include": "#size"
    },
    {
      "include": "#register"
    },
    {
      "include": "#control"
    },
    {
      "include": "#number"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.semicolon.asm",
      "match": ";.*$"
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.asm",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.asm"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.asm"
            }
          }
        },
        {
          "name": "string.quoted.single.asm",
          "begin": "'",
          "end": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.asm"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.asm"
            }
          }
        },
        {
          "name": "string.quoted.backtick.asm",
          "begin": "`",
          "end": "`",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.asm"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.asm"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.asm",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "preprocessor": {
      "name": "meta.preprocessor.asm",
      "match": "%(?i:define|xdefine|undef|assign|macro|endmacro|imacro|include|if|ifdef|ifndef|elif|else|endif|rep|endrep|error|warning|local|rotate|strlen|substr|use|push|pop|line)\\b",
      "captures": {
        "0": {
          "name": "entity.name.function.preprocessor.asm"
        }
      }
    },
    "label": {
      "match": "^\\s*(\\.?[A-Za-z_$?@][\\w$?@.]*)(:)",
      "captures": {
        "1": {
          "name": "entity.name.function.label.asm"
        },
        "2": {
          "name": "punctuation.separator.label.asm"
        }
      }
    },
    "directive": {
      "name": "storage.type.directive.asm",
      "match": "\\b(?i:section|segment|global|extern|common|bits|use16|use32|use64|default|org|align|alignb|times|equ|incbin|struc|endstruc|istruc|iend|at|cpu|float|rel|abs|d[bwdqtoyz]|res[bwdqtoyz])\\b"
    },
    "size": {
      "name": "storage.modifier.size.asm",
      "match": "\\b(?i:byte|word|dword|qword|tword|oword|yword|zword|ptr|near|far|short|strict)\\b"
    },
    "register": {
      "name": "variable.other.register.asm",
      "match": "\\b(?i:r(?:[abcd]x|[sd]i|[sb]p|ip|(?:8|9|1[0-5])[dwb]?)|e(?:[abcd]x|[sd]i|[sb]p|ip)|[abcd][xlh]|[sd]il?|[sb]pl?|[cdefgs]s|[xyz]mm(?:[12]?[0-9]|3[01])|cr[0-8]|dr[0-7]|st[0-7]|k[0-7])\\b"
    },
    "control": {
      "name": "keyword.control.asm",
      "match": "\\b(?i:j(?:mp|n?[abceglopsz]|n?[abgl]e|cxz|ecxz|rcxz|p[eo])|call|ret[fn]?|iret[dq]?|loop(?:n?[ez])?|int[o3]?|syscall|sysret|sysenter|sysexit|hlt|leave|enter)\\b"
    },
    "number": {
      "name": "constant.numeric.asm",
      "match": "(?i)\\b(?:0x[0-9a-f_]+|0b[01_]+|0o[0-7_]+|[0-9][0-9a-f_]*h|[01_]+b|[0-7_]+[oq]|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:e[+-]?[0-9]+)?)\\b|\\$[0-9][0-9a-f_]*\\b"
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.memory.asm",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.separator.comma.asm",
          "match": ","
        },
        {
          "name": "keyword.operator.asm",
          "match": "[-+*/%|&^~<>]"
        }
      ]
    },
    "data-label": {
      "match": "^\\s*(\\.?[A-Za-z_$?@][\\w$?@.]*)\\s+(?=(?i:section|segment|global|extern|common|bits|use16|use32|use64|default|org|align|alignb|times|equ|incbin|struc|endstruc|istruc|iend|at|cpu|float|d[bwdqtoyz]|res[bwdqtoyz])\\b)",
      "captures": {
        "1": {
          "name": "entity.name.function.label.asm"
        }
      }
    },
    "statement": {
      "match": "^\\s*(?:(\\.?[A-Za-z_$?@][\\w$?@.]*)(:)\\s*)?((?i:lock|rep(?:n?[ez])?)\\s+)?(?!(?i:section|segment|global|extern|common|bits|use16|use32|use64|default|org|align|alignb|times|equ|incbin|struc|endstruc|istruc|iend|at|cpu|float|d[bwdqtoyz]|res[bwdqtoyz])\\b)(?!(?i:j(?:mp|n?[abceglopsz]|n?[abgl]e|cxz|ecxz|rcxz|p[eo])|call|ret[fn]?|iret[dq]?|loop(?:n?[ez])?|int[o3]?|syscall|sysret|sysenter|sysexit|hlt|leave|enter)\\b)([A-Za-z][A-Za-z0-9]*)\\b(?!:)",
      "captures": {
        "1": {
          "name": "entity.name.function.label.asm"
        },
        "2": {
          "name": "punctuation.separator.label.asm"
        },
        "3": {
          "name": "storage.modifier.prefix.asm"
        },
        "4": {
          "name": "support.function.instruction.asm"
        }
      }
    }
  }
}